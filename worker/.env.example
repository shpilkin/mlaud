# Скопируй в .env и заполни. .env в .gitignore — не коммитить!
MLAUD_TG_TOKEN=123456:ABC-your-bot-token
MLAUD_TG_CHAT_ID=123456789

# Пути (опционально; иначе дефолтные ~/ASR и iCloud)
